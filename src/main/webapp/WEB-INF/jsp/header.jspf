<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="hc" uri="/WEB-INF/hostel.tld" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="me" value="${sessionScope.user}"/>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> · HostelCare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/css/style.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛠️</text></svg>">
</head>
<body>
<header class="topbar">
    <a class="brand" href="${ctx}/"><span class="logo">🛠️</span> HostelCare
        <small><c:out value="${applicationScope.hostelName}"/></small></a>
    <c:if test="${not empty me}">
        <nav>
            <a href="${ctx}/dashboard">Dashboard</a>
            <c:if test="${me.student}"><a href="${ctx}/complaint?action=new">Raise complaint</a></c:if>
            <c:if test="${me.warden}">
                <a href="${ctx}/reports">Reports</a>
                <a href="${ctx}/admin/users">Users</a>
            </c:if>
            <a href="${ctx}/api-console">REST API</a>
        </nav>
        <div class="who">
            <a href="${ctx}/profile" class="avatar" title="Profile">${fn:substring(me.name, 0, 1)}</a>
            <div><b><c:out value="${me.name}"/></b><span class="role role-${fn:toLowerCase(me.role)}">${me.role}</span></div>
            <a class="btn btn-ghost btn-sm" href="${ctx}/logout">Log out</a>
        </div>
    </c:if>
</header>
<main class="container">
<c:if test="${not empty sessionScope.flash}">
    <div class="alert alert-${sessionScope.flashType}"><c:out value="${sessionScope.flash}"/></div>
    <c:remove var="flash" scope="session"/>
    <c:remove var="flashType" scope="session"/>
</c:if>
